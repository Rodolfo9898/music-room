# syntax=docker/dockerfile:1.7

FROM ubuntu:24.04 AS flutter-base

ARG FLUTTER_VERSION=3.44.7
ARG FLUTTER_CHANNEL=stable
ARG FLUTTER_HOME=/opt/flutter

ENV DEBIAN_FRONTEND=noninteractive
ENV FLUTTER_HOME=${FLUTTER_HOME}
ENV PATH=${FLUTTER_HOME}/bin:${FLUTTER_HOME}/bin/cache/dart-sdk/bin:${PATH}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        clang \
        cmake \
        curl \
        file \
        git \
        libglu1-mesa \
        libgtk-3-dev \
        ninja-build \
        openjdk-17-jdk \
        pkg-config \
        unzip \
        xz-utils \
        zip \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --filter=blob:none --branch ${FLUTTER_CHANNEL} \
        https://github.com/flutter/flutter.git ${FLUTTER_HOME} \
    && cd ${FLUTTER_HOME} \
    && git fetch --depth 1 origin refs/tags/${FLUTTER_VERSION}:refs/tags/${FLUTTER_VERSION} \
    && git checkout ${FLUTTER_VERSION} \
    && git config --global --add safe.directory ${FLUTTER_HOME}

RUN flutter --version \
    && flutter config --enable-web --enable-android --enable-ios \
    && flutter doctor -v

FROM --platform=linux/amd64 flutter-base AS android-tooling

ARG ANDROID_API_LEVEL=36
ARG ANDROID_BUILD_TOOLS=36.0.0
ARG ANDROID_CMDLINE_TOOLS_VERSION=13114758

ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV PATH=${PATH}:${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin:${ANDROID_SDK_ROOT}/platform-tools

RUN mkdir -p ${ANDROID_SDK_ROOT}/cmdline-tools \
    && curl -fsSL \
        "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_VERSION}_latest.zip" \
        -o /tmp/android-commandlinetools.zip \
    && unzip -q /tmp/android-commandlinetools.zip -d ${ANDROID_SDK_ROOT}/cmdline-tools \
    && mv ${ANDROID_SDK_ROOT}/cmdline-tools/cmdline-tools ${ANDROID_SDK_ROOT}/cmdline-tools/latest \
    && rm /tmp/android-commandlinetools.zip \
    && yes | sdkmanager --sdk_root="${ANDROID_SDK_ROOT}" --licenses >/dev/null \
    && sdkmanager --sdk_root="${ANDROID_SDK_ROOT}" \
        "platform-tools" \
        "platforms;android-${ANDROID_API_LEVEL}" \
        "build-tools;${ANDROID_BUILD_TOOLS}"

FROM flutter-base AS ci-web

ARG MUSIC_ROOM_SERVER=localhost:8080

WORKDIR /workspace/app

COPY . .
RUN flutter pub get \
    && flutter build web --release --dart-define=MUSIC_ROOM_SERVER=${MUSIC_ROOM_SERVER}

FROM android-tooling AS ci-android

ARG MUSIC_ROOM_SERVER=localhost:8080

WORKDIR /workspace/app

COPY . .
RUN flutter pub get \
    && flutter build apk --release --dart-define=MUSIC_ROOM_SERVER=${MUSIC_ROOM_SERVER}

FROM flutter-base AS ci-ios

WORKDIR /workspace/app

COPY . .

# Linux containers cannot produce iOS binaries because Xcode/macOS is required.
RUN flutter pub get \
    && flutter analyze \
    && flutter test

FROM android-tooling AS mobile-runtime

WORKDIR /workspace/app

COPY . .
RUN flutter pub get

CMD ["bash"]
