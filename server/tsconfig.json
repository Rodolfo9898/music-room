{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "lib": [
      "es2023",
      "DOM"
    ],
    "rootDir": "src",
    "outDir": "dist",
    "module": "commonjs",
    "moduleResolution": "node",
    "sourceMap": false,
    "skipLibCheck": true,
    "target": "es2017"
  },
  "exclude": [
    "test",
    "dist",
    "node_modules"
  ]
}
